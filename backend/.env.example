# Copy to backend/.env and fill in the providers you want.
# A provider with no key simply shows as "offline" in the UI — nothing breaks.

# https://console.groq.com/keys
GROQ_API_KEY=

# https://aistudio.google.com/apikey  (GOOGLE_API_KEY also works)
GEMINI_API_KEY=

# Ollama needs no key — just the daemon running. Override the host if remote.
# OLLAMA_HOST=http://127.0.0.1:11434

# Comma-separated browser origins allowed to call the API.
# Any localhost port is allowed by default; set this for a deployed frontend.
# Required in production: session cookies cannot travel to a wildcard origin.
# ALLOWED_ORIGINS=https://your-app.example.com


# --- database (AWS RDS PostgreSQL) ------------------------------------------
#
# REQUIRED. The instance endpoint and credentials from the RDS console. The
# database named by DB_NAME is created on first boot if it does not exist yet.
DB_HOST=database-1.xxxxxxxxxxxx.eu-north-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=nexus
DB_USER=postgres
DB_PASSWORD=

# Or hand over one complete URL instead of the parts above:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/nexus

# TLS. RDS insists on it; verify-full additionally checks the server's
# certificate against Amazon's CA bundle at backend/global-bundle.pem
# (https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem).
# DB_SSLMODE=verify-full
# DB_SSL_ROOT_CERT=global-bundle.pem
# DB_CONNECT_TIMEOUT=10

# Pooled connections per process / extra ones allowed under load. Every worker
# and every instance shares the RDS connection cap (~100 on a micro instance).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10


# --- accounts & sessions ---------------------------------------------------

# Signing key for JWT access tokens. REQUIRED in production — anyone holding
# it can mint a token for any account, so treat it like a password and rotate
# it if it leaks (rotating signs everyone out, which is the point).
# Left unset, a random key is generated per process: fine for a single dev
# server, broken across a restart or a second worker.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# JWT_ISSUER=nexus

# Access tokens are unrevocable until they expire, so keep this short.
# ACCESS_TOKEN_TTL_MINUTES=15
# Refresh tokens are revocable and rotate on every use.
# REFRESH_TOKEN_TTL_DAYS=30
# MAX_SESSIONS_PER_USER=10
# REFRESH_REUSE_GRACE_SECONDS=10
# REFRESH_COOKIE_NAME=rt

# Turn BOTH of these on behind HTTPS. Set COOKIE_SAMESITE=none only when the
# frontend is served from a different site than the API.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax

# Failed logins per email (and per IP) before a temporary lockout.
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_LOCKOUT_SECONDS=900


# --- chat memory -----------------------------------------------------------

# How many stored messages get replayed to the model. Older turns stay in the
# database and on screen; they just stop being sent upstream.
# MEMORY_WINDOW_MESSAGES=40

# Prepended to every thread that has no system prompt of its own.
# DEFAULT_SYSTEM_PROMPT=You are a concise, helpful assistant.

# Hard cap on the length of one reply. Also bounds how far a nearly-empty
# balance can be overdrawn by its final turn.
# MAX_COMPLETION_TOKENS=2048


# --- credits & paywall -----------------------------------------------------
#
# Usage is metered in credits: 1 credit = 1 token on a free-tier model.
# Premium models charge a multiple per token. Every model on every provider
# (Ollama included) draws from the same balance.

# Credits every new account starts with.
# FREE_SIGNUP_CREDITS=20000

# The one pack on sale: pay PAID_PACK_PRICE_INR by UPI, get PAID_PACK_CREDITS
# and premium models unlocked. Approved by hand — see backend/billing_cli.py.
# PAID_PACK_PRICE_INR=10
# PAID_PACK_CREDITS=200000

# Credits charged per token, by tier.
# FREE_CREDITS_PER_TOKEN=1
# PREMIUM_CREDITS_PER_TOKEN=5

# Which models are premium. By default, any model whose catalog speed is
# "Balanced" or "Deep" (for Ollama that means roughly >15B parameters).
# Override per model with comma-separated ids, optionally as provider:model.
# PREMIUM_SPEEDS=Balanced,Deep
# PREMIUM_MODELS=llama-3.3-70b-versatile,ollama:llama3:70b
# FREE_MODELS=gemini-3.1-pro-preview

# Your UPI VPA. REQUIRED for the paywall to show a way to pay — without it,
# premium models stay locked and the top-up screen says payments are off.
# UPI_ID=yourname@okaxis
# UPI_PAYEE_NAME=Your Name
# Optional: serve your own QR image (from your bank app) instead of a
# generated one. Path relative to backend/, or absolute.
# UPI_QR_IMAGE=static/upi-qr.png
